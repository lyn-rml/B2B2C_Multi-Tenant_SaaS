{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Student Marketplace API",
    "description" : "Authentication, tenant onboarding (US-000), module catalog and provisioning (US-001)",
    "version" : "0.2.0"
  },
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "tags" : [ {
    "name" : "Platform administration",
    "description" : "US-000 and US-001; requires PLATFORM_ADMIN"
  } ],
  "paths" : {
    "/api/platform/tenants" : {
      "get" : {
        "tags" : [ "Platform administration" ],
        "operationId" : "tenants",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/TenantDto"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "Platform administration" ],
        "operationId" : "createTenant",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateTenantRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TenantDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/modules" : {
      "get" : {
        "tags" : [ "Platform administration" ],
        "operationId" : "modules",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ModuleDto"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "Platform administration" ],
        "operationId" : "createModule",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateModuleRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ModuleDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/module-assignments" : {
      "post" : {
        "tags" : [ "Platform administration" ],
        "operationId" : "assignModules",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AssignModulesRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/TenantDetails"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register" : {
      "post" : {
        "tags" : [ "Authentication" ],
        "summary" : "Register a new user",
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        },
        "security" : [ ]
      }
    },
    "/api/auth/otp/verify" : {
      "post" : {
        "tags" : [ "Authentication" ],
        "summary" : "Verify email OTP and receive JWT",
        "operationId" : "verifyOtp",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/OtpVerifyRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        },
        "security" : [ ]
      }
    },
    "/api/auth/otp/request" : {
      "post" : {
        "tags" : [ "Authentication" ],
        "summary" : "Request a one-time login code by email",
        "operationId" : "requestOtp",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/OtpRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "security" : [ ]
      }
    },
    "/api/auth/login" : {
      "post" : {
        "tags" : [ "Authentication" ],
        "summary" : "Login with email and password",
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        },
        "security" : [ ]
      }
    },
    "/api/tenants/{id}" : {
      "get" : {
        "tags" : [ "Tenant access" ],
        "operationId" : "tenant",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TenantDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/tenants/{id}" : {
      "get" : {
        "tags" : [ "Platform administration" ],
        "operationId" : "tenant_1",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TenantDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/tenants/{id}/modules" : {
      "get" : {
        "tags" : [ "Platform administration" ],
        "operationId" : "tenantModules",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ModuleDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health" : {
      "get" : {
        "tags" : [ "Health" ],
        "summary" : "Health check",
        "operationId" : "health",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : {
                    "type" : "string"
                  }
                }
              }
            }
          }
        },
        "security" : [ ]
      }
    },
    "/api/auth/me" : {
      "get" : {
        "tags" : [ "Authentication" ],
        "summary" : "Current user profile and roles",
        "operationId" : "me",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "CreateTenantRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 150,
            "minLength" : 0
          },
          "tenantAdminUserId" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "tenantAdminUserId" ]
      },
      "TenantDto" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "schemaName" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          }
        }
      },
      "CreateModuleRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 150,
            "minLength" : 0
          },
          "code" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "[A-Za-z][A-Za-z0-9_]{0,39}"
          },
          "description" : {
            "type" : "string",
            "maxLength" : 10000,
            "minLength" : 0
          }
        }
      },
      "ModuleDto" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "name" : {
            "type" : "string"
          },
          "code" : {
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          },
          "provisioningSupported" : {
            "type" : "boolean"
          }
        }
      },
      "AssignModulesRequest" : {
        "type" : "object",
        "properties" : {
          "tenantIds" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "format" : "uuid"
            },
            "maxItems" : 100,
            "minItems" : 0
          },
          "moduleCodes" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "minLength" : 1,
              "pattern" : "[A-Za-z][A-Za-z0-9_]{0,39}"
            },
            "maxItems" : 20,
            "minItems" : 0
          }
        }
      },
      "TenantDetails" : {
        "type" : "object",
        "properties" : {
          "tenant" : {
            "$ref" : "#/components/schemas/TenantDto"
          },
          "modules" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ModuleDto"
            }
          }
        }
      },
      "RegisterRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "minLength" : 1
          },
          "fullName" : {
            "type" : "string",
            "minLength" : 1
          },
          "password" : {
            "type" : "string",
            "minLength" : 1
          },
          "role" : {
            "type" : "string",
            "enum" : [ "STUDENT", "EMPLOYEE", "STORE_ADMIN", "PLATFORM_ADMIN", "TENANT_ADMIN" ]
          },
          "tenantId" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "role" ]
      },
      "AuthResponse" : {
        "type" : "object",
        "properties" : {
          "token" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "fullName" : {
            "type" : "string"
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/RoleClaim"
            }
          }
        }
      },
      "RoleClaim" : {
        "type" : "object",
        "properties" : {
          "role" : {
            "type" : "string",
            "enum" : [ "STUDENT", "EMPLOYEE", "STORE_ADMIN", "PLATFORM_ADMIN", "TENANT_ADMIN" ]
          },
          "tenantId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "tenantName" : {
            "type" : "string"
          }
        }
      },
      "OtpVerifyRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "minLength" : 1
          },
          "code" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "\\d{6}"
          }
        }
      },
      "OtpRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "minLength" : 1
          }
        }
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "minLength" : 1
          },
          "password" : {
            "type" : "string",
            "minLength" : 1
          }
        }
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}
